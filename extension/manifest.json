{
  "manifest_version": 3,
  "name": "COFRE - relleno de secretos",
  "version": "1.3.0",
  "description": "Rellena contrasenas y claves solo cuando tu lo pides, en los dominios autorizados. El secreto nunca sale del equipo.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "COFRE"
  },
  "key": "",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Abrir COFRE"
    }
  }
}
